;; ============================================================================
;; FIRE AND SMOKE
;;
;; Scale: 1 patch = 1 m and 1 tick = 1 s, as in the rest of the model.
;;
;; How the fire works:
;;   - At first only fuel burns: desks and doors (patches with inflammatory?
;;     = true, set in the environment file) and the carpet in the rooms.
;;     The rest of a room only burns after flashover (see below); corridors
;;     and walls never burn.
;;   - CARPET: every room with furniture (and not bigger than the biggest
;;     room) has carpet. Carpet burns weakly (a quarter of a desk) and only
;;     catches fire from burning furniture or doors nearby, never from other
;;     carpet: on its own a carpet does not carry a fire across the room, it
;;     needs the heat of something burning next to it (floor coverings in
;;     public buildings only keep burning under strong heat, EN 13501-1).
;;   - A burning patch starts small and grows to full strength in
;;     fire-growth-time seconds. After fire-burn-time seconds its fuel is used
;;     up and it is burned out (grey).
;;   - Every second, a burning patch can set fuel up to fire-reach metres away
;;     on fire (heat radiation), but never through a wall or a closed door.
;;     The stronger the fire, the bigger the chance. An open door (the wooden
;;     door leaf) resists fire much longer than a desk.
;;   - AIR: a fire needs oxygen. The fire in a room can only grow as big as
;;     the air coming in through its doorways can feed: 1500 kW for every m2
;;     of open doorway, times the square root of its height (Kawagoe, 1958).
;;     A closed door only lets a little air in through the gaps around it, so
;;     a fire in a closed room stays small. When someone opens the door, the
;;     fire gets air and grows again. (Doors: see doors.nls.)
;;   - FLASHOVER: walls and doors split the building into rooms. When the fire
;;     in a room gets big enough, the hot smoke under the ceiling sets
;;     everything in the room on fire at once (chairs, carpet, paper, ...).
;;     Then the whole room burns and flames come out of its open doorways,
;;     about flame-reach metres into the corridor: nobody can pass there, and
;;     the flames can light fuel nearby. The corridor floor itself does not
;;     burn: corridors have (almost) no fuel, and escape routes must be lined
;;     with materials that do not spread fire (Dutch building rules).
;;     How big the fire must be depends on the room: small rooms with small
;;     doors flash over quickly, big halls never do (Thomas' flashover formula).
;;     A closed room does not get enough air to flash over.
;;   - CLOSED DOORS hold back the fire like a weak wall: a closed door next to
;;     a fully burning patch burns through after door-fire-resistance minutes,
;;     and is then a hole (smoke, heat and air pass it; flames come out of it
;;     if the room behind it has flashed over).
;;   - WALLS hold back fire and smoke. A wall next to a fully burning patch
;;     heats up; after wall-fire-resistance minutes (interface) it fails: smoke
;;     flows through it, and the failed wall burns. Its fire counts for the
;;     room behind it, so a small room behind it soon flashes over too.
;;     Real walls between rooms hold back fire for 30 to 60 minutes (Dutch
;;     building code: WBDBO), light partitions much shorter. People still
;;     cannot walk through a failed wall.
;;
;; How the smoke works:
;;   - Every burning patch makes smoke, more when its fire is stronger.
;;   - Hot smoke flows away from the fire (under the ceiling) at about
;;     smoke-flow-speed m/s, through doorways into corridors and other rooms,
;;     and piles up where it cannot go further (the far ends of rooms and
;;     corridors). Further than smoke-flow-reach metres from the fire the smoke
;;     has cooled down and flows slower and slower (twice as far = half as
;;     fast). For this we use a "distance map" from the fire, the same
;;     idea as the exit maps in navigation.nls: smoke moves to the
;;     neighbouring patches that are further from the fire.
;;   - Smoke also mixes with the neighbouring patches, from thick to thin.
;;   - Smoke never goes through a wall or a closed door, and escapes outside
;;     through the exit doors. ASSUMPTION: the little smoke that leaks through
;;     the gaps around a closed door is ignored.
;;   - ASSUMPTION: one smoke value per patch. We do not model the hot smoke
;;     layer under the ceiling separately.
;;   - The darker the grey of a floor patch, the thicker the smoke.
;;
;; How the heat works:
;;   - Every patch has a temperature. A burning patch is as hot as its flames
;;     (up to ambient-temperature + flame-heat, about 820 C at full strength).
;;   - The heat travels with the hot smoke: it flows and mixes in exactly the
;;     same way, never passes walls or closed doors, and escapes through the
;;     exit doors. On the way the hot smoke cools down: every second it loses
;;     a part heat-loss of its heat to the walls and ceiling.
;;   - So a room that has flashed over is about 800 C, the corridor in front
;;     of its door is very hot, and far away the smoke is barely warm.
;;   - ASSUMPTION: like the smoke, one temperature per patch. In reality the
;;     hot smoke layer under the ceiling is hotter than the air lower down.
;;   - What the heat does to people is in update-evacuee-health (evacuees.nls).
;;
;; The same fire in every run:
;;   - fire-location (interface) picks the desk where the fire starts.
;;   - The fire uses its own random numbers, set by fire-seed (interface).
;;     Two runs with the same fire-seed and fire-location start with the same
;;     fire and the same open and closed doors. The people only change the
;;     fire by opening and closing doors, so as long as they do that in the
;;     same way, the fire and smoke are exactly the same. That makes it fair
;;     to compare cognitive strategies, alarms and helpers. With fire-seed 0
;;     every run gets a different fire.
;;
;; The agents read these patch variables:
;;   fire?   true while the patch burns (agents cannot walk on it)
;;   smoke   smoke density from 0 (clean air) to 1 (thick smoke)
;;   temperature (reporter)  air temperature in C
;; ============================================================================

patches-own [
  fire?           ;; true while this patch burns
  fire-strength   ;; how strong the fire on this patch is, from 0 (just started) to 1 (full)
  fire-time       ;; seconds this patch has been burning
  burned?         ;; true once the fuel on this patch is used up
  carpet?         ;; true for the floor of a room with carpet (weak fuel)
  smoke           ;; smoke density from 0 (clean air) to 1 (thick smoke)
  indoor?         ;; true for every patch inside the building
  room            ;; number of the room this patch is in (-1 for walls, doors and outside)
  wall-heat       ;; seconds a wall or closed door has had a fully burning patch next to it
  smoke-neighbors ;; the neighbouring patches smoke can flow to (not walls, not outside)
  new-smoke       ;; helper for spread-smoke: the smoke on this patch after this step
  heat            ;; how much hotter (C) the air on this patch is than ambient-temperature
  new-heat        ;; helper for spread-smoke: the heat on this patch after this step
  fire-distance   ;; number of steps from this patch to the nearest fire (for the smoke flow)
  downwind        ;; the smoke-neighbors further from the fire: where smoke flows to
]

globals [
  ;; ---- values used by the fire (ASSUMPTION: set in set-fire-parameters) ----
  fire-growth-time    ;; seconds a burning patch needs to reach full strength
  fire-burn-time      ;; seconds a patch burns before its fuel is used up
  fire-reach          ;; distance (m) over which a burning patch can set fuel on fire
  desk-catch-chance   ;; chance per second that a desk catches fire from one fully burning patch nearby
  door-catch-chance   ;; the same for a door
  desk-power          ;; fire power (kW) of one fully burning desk patch (also doors, failed walls and room contents after flashover)
  carpet-power        ;; fire power (kW) of one fully burning patch of carpet
  carpet-catch-chance ;; chance per second that carpet catches fire from one fully burning desk or door nearby
  ceiling-height      ;; height (m) of the rooms
  door-height         ;; height (m) of the doors
  max-flashover-area  ;; rooms bigger than this (m2) never flash over and never run out of air
  flashed-over-rooms  ;; list with the numbers of the rooms that have flashed over
  air-power           ;; fire power (kW) the air through 1 m2 of doorway can feed (times the square root of its height)
  door-leakage        ;; the gaps around a closed door, as a part of the doorway (they let a little air in)
  door-fire-resistance ;; minutes a closed door holds back a fully burning fire next to it
  flame-reach         ;; distance (m) flames reach out of the doorway of a room that has flashed over

  ;; ---- the rooms, measured once in setup-rooms (item n is room number n) ----
  room-areas          ;; floor area (m2)
  room-surfaces       ;; surface area (m2): floor, ceiling and walls
  room-doorways       ;; the door patches around the room (inner doors and exits)

  ;; ---- values used by the smoke (ASSUMPTION: set in set-fire-parameters) ----
  smoke-production    ;; smoke a fully burning patch adds per second
  smoke-flow-speed    ;; speed (m/s) at which smoke flows away from the fire
  smoke-flow-reach    ;; distance (m) from the fire after which the flow slows down
  smoke-spread        ;; how fast smoke evens out between neighbouring patches (0 to 1)
  smoke-spread-steps  ;; how many times per second the smoke flows and spreads

  ;; ---- values used by the heat (ASSUMPTION: set in set-fire-parameters) ----
  ambient-temperature ;; temperature (C) of the air before the fire
  flame-heat          ;; how much hotter (C) than ambient a fully burning patch is
  heat-loss           ;; part of its heat the hot smoke loses per second to the walls and ceiling
  fire-count-last-smoke-map ;; number of burning patches when the fire distance map was last made

  smoke-patches       ;; all patches smoke can be on: inside the building and not a wall
  fire-dice           ;; the seed for the fire's own random numbers (see "The same fire in every run")
]


;; ---------------------------------------------------------------------------
;; Setup
;; ---------------------------------------------------------------------------

to set-fire-parameters
  set fire-growth-time 120     ;; ASSUMPTION: a desk fire needs about 2 minutes to grow to full strength
  set fire-burn-time 1800      ;; ASSUMPTION: a patch burns for about 30 minutes (office fire load ~420 MJ/m2 burning at ~250 kW/m2, Eurocode EN 1991-1-2)
  set fire-reach 2             ;; ASSUMPTION: a burning desk can set fuel up to 2 m away on fire
  set desk-catch-chance 0.02   ;; ASSUMPTION: a desk next to a fully burning desk catches fire after about a minute
  set door-catch-chance 0.002  ;; ASSUMPTION: a door resists fire ten times longer than a desk
  set desk-power 1000          ;; ASSUMPTION: a desk patch is a desk with chair, computer and paper; a workstation burns at 1-3 MW
  set carpet-power 250         ;; ASSUMPTION: burning carpet gives about a quarter of the power of a desk
  set carpet-catch-chance 0.002 ;; ASSUMPTION: carpet next to a fully burning desk catches fire after a few minutes, like a door
  set ceiling-height 3         ;; ASSUMPTION
  set door-height 2.1          ;; ASSUMPTION: a normal door; each door patch is 1 m wide
  set max-flashover-area 500   ;; ASSUMPTION: the central hall (~3900 m2, no furniture) is too big to flash over; the biggest room is ~350 m2
  set air-power 1500           ;; Kawagoe (1958): a room fire burns at most ~1500 kW per m2 of opening x square root of its height (m)
  set door-leakage 0.04        ;; ASSUMPTION: gaps of about 1 cm around a closed door and 2 cm under it: ~4% of the doorway
  set door-fire-resistance 10  ;; ASSUMPTION: an ordinary inner door (no fire door) holds back a fire for 5-20 min; a fire door 30+ min (EN 1634-1)
  set flame-reach 2            ;; ASSUMPTION: after flashover, flames come 1-2 m out of a doorway (the fuel that cannot burn inside burns outside)
  set smoke-flow-speed 1       ;; ASSUMPTION: smoke leaves a burning room at about 1 m/s
  set smoke-flow-reach 10      ;; ASSUMPTION: after about 10 m the smoke cools and slows down (ceiling jet, Alpert)
  ;; ASSUMPTION: these three are chosen so that the room with the fire gets
  ;; noticeable smoke after 2-3 minutes and is full of smoke when it flashes over.
  set smoke-production 0.25
  set smoke-spread 0.8
  set smoke-spread-steps 4
  set ambient-temperature 20   ;; ASSUMPTION: a normal indoor temperature
  set flame-heat 800           ;; ASSUMPTION: flames and a flashed-over room are about 800-900 C (Drysdale, 2011)
  set heat-loss 0.1            ;; ASSUMPTION: chosen so that the hot smoke has cooled to about 100 C some 10 m from a burning room
end

;; Called once from setup: nothing burns, then one desk catches fire.
to setup-fire
  set-fire-parameters
  ask patches [
    set fire? false
    set fire-strength 0
    set fire-time 0
    set burned? false
    set carpet? false
    set smoke 0
    set heat 0
    set wall-heat 0
  ]
  ifelse fire-seed = 0
    [ set fire-dice random 1000000 ]   ;; a different fire every run
    [ set fire-dice fire-seed ]        ;; the same fire every run

  setup-doors                        ;; doors.nls: some doors open, the others closed
  setup-smoke-patches
  setup-rooms
  setup-carpet
  set flashed-over-rooms []
  set fire-count-last-smoke-map -1   ;; the fire distance map is made in the first second

  with-local-randomness [
    random-seed fire-dice
    ask fire-start-patch [ catch-fire ]
  ]
end

;; The desk where the fire starts, chosen with the fire-location chooser.
to-report fire-start-patch
  let desks patches with [object = "desk"]
  if fire-location = "north-west office" [ report min-one-of desks [distancexy -44 26] ]
  if fire-location = "north classroom"   [ report min-one-of desks [distancexy -33 34] ]
  if fire-location = "auditorium"        [ report min-one-of desks [distancexy 0 -25] ]
  report one-of desks                    ;; "random desk"
end

;; Find the patches smoke can be on. Outside the building is everything that
;; can be reached from the corner of the world without passing a wall, desk or
;; door (the same idea as color-outside-green in the environment file).
to setup-smoke-patches
  ask patches [ set indoor? true ]
  let frontier (patch-set patch min-pxcor max-pycor)
  ask frontier [ set indoor? false ]
  while [any? frontier] [
    let next-frontier no-patches
    ask frontier [
      ask neighbors4 with [indoor? and (object = "floor" or object = "tree")] [
        set indoor? false
        set next-frontier (patch-set next-frontier self)
      ]
    ]
    set frontier next-frontier
  ]

  set smoke-patches patches with [indoor? and object != "wall"]
  ask smoke-patches [ set smoke-neighbors smoke-routes ]
end

;; The neighbouring patches smoke can flow to from here: inside the building,
;; not a wall and not a closed door. A closed door has none: smoke cannot pass it.
to-report smoke-routes  ;; patch reporter
  if closed-door? [ report no-patches ]
  report neighbors4 with [indoor? and object != "wall" and not closed-door?]
end

;; A door opened or closed, or a wall failed: work out again where smoke can
;; flow from this patch and from the patches around it.
to update-smoke-routes  ;; patch procedure
  set smoke-neighbors smoke-routes
  ask neighbors4 with [indoor? and object != "wall"] [ set smoke-neighbors smoke-routes ]
  set fire-count-last-smoke-map -1   ;; the smoke flows another way now: make the fire distance map again
end

;; Give every room a number: a room is a group of patches that touch each
;; other without a wall or door in between. Then measure every room for the
;; flashover and air formulas.
to setup-rooms
  ask patches [ set room -1 ]
  let room-number 0
  while [any? patches with [in-a-room? and room = -1]] [
    ask one-of patches with [in-a-room? and room = -1] [ fill-room room-number ]
    set room-number room-number + 1
  ]
  set room-areas []
  set room-surfaces []
  set room-doorways []
  foreach range room-number [ number -> measure-room number ]
end

;; Every room with furniture that is not bigger than max-flashover-area gets
;; carpet on its floor. The central hall (with the auditorium), the corridors
;; and the closed courtyards get none.
to setup-carpet
  let carpet-rooms remove-duplicates [room] of patches with [object = "desk" and room != -1]
  ask patches with [object = "floor" and member? room carpet-rooms and not big-room? room] [
    set carpet? true
    set inflammatory? true
  ]
end

;; Inside the building, and not a wall or a door.
to-report in-a-room?  ;; patch reporter
  report indoor? and object != "wall" and not door?
end

to-report door?  ;; patch reporter
  report member? object ["door" "intermediate-door"]
end

;; Give my whole room the same number (a flood fill that stops at walls and doors).
to fill-room [number]  ;; patch procedure
  set room number
  let frontier (patch-set self)
  while [any? frontier] [
    let next-frontier no-patches
    ask frontier [
      ask neighbors4 with [in-a-room? and room = -1] [
        set room number
        set next-frontier (patch-set next-frontier self)
      ]
    ]
    set frontier next-frontier
  ]
end

;; Measure room 'number': its floor area, its surface area (the floor, the
;; ceiling and the walls, without the doorways) and the doors around it.
to measure-room [number]
  let room-patches patches with [room = number]
  let doorway-patches patches with [door? and any? neighbors4 with [room = number]]
  let floor-area count room-patches
  let wall-length count room-patches with [any? neighbors4 with [object = "wall" or door?]]
  let surface-area (2 * floor-area) + (wall-length * ceiling-height) - (door-height * count doorway-patches)
  set room-areas lput floor-area room-areas
  set room-surfaces lput surface-area room-surfaces
  set room-doorways lput doorway-patches room-doorways
end

;; ASSUMPTION: a space bigger than max-flashover-area (the central hall with
;; its corridors) never flashes over: it has no furniture and the smoke
;; spreads out and cools down. It also has so much air that its fire never
;; runs out of it.
to-report big-room? [number]
  report item number room-areas > max-flashover-area
end

;; The open doorway area (m2) of room 'number'. Every door patch is 1 m wide.
;; A closed door still counts for a small part (door-leakage): the gaps around it.
to-report open-doorway-area [number]
  let doorway-patches item number room-doorways
  let open-patches count doorway-patches with [not closed-door?]
  let closed-patches count doorway-patches with [closed-door?]
  report door-height * (open-patches + door-leakage * closed-patches)
end

;; The fire power (kW) a room needs to flash over, with Thomas' formula
;; (Thomas, 1981):
;;   power (kW) = 7.8 x surface area of the room (m2)
;;              + 378 x open doorway area (m2) x square root of the door height (m)
;; A big room loses more heat to its walls and open doors let more heat out,
;; so both need a bigger fire before flashover.
to-report flashover-power [number]
  if big-room? number [ report never ]
  report (7.8 * item number room-surfaces) + (378 * open-doorway-area number * sqrt door-height)
end

;; The biggest fire (kW) the air coming in through the doorways can feed
;; (Kawagoe, 1958):
;;   power (kW) = 1500 x open doorway area (m2) x square root of the door height (m)
;; Example: one open door of 1 x 2.1 m feeds about 4.6 MW, enough for a small
;; room to flash over. The same door closed feeds only about 0.2 MW.
to-report air-limit [number]
  report air-power * open-doorway-area number * sqrt door-height
end

;; The fire power (kW) of everything that burns in room 'number' right now.
to-report room-fire-power [number]
  report sum [fire-strength * full-power] of patches with [fire? and room = number]
end

;; A fire power no fire in this building can reach: "never flashes over".
to-report never
  report 999999999
end


;; ---------------------------------------------------------------------------
;; Schedule step (1): the fire grows and spreads
;; ---------------------------------------------------------------------------

to spread-fire
  ;; The fire's own random numbers: the same fire-dice and tick give the same fire.
  with-local-randomness [
    random-seed fire-dice + ticks
    grow-and-spread-fire
  ]
end

;; The basic rule "burning patches set nearby fuel on fire with some chance"
;; is the classic rule of the NetLogo Fire model (Wilensky, 1997) and Fire
;; Simple Extension 1 (Wilensky, 2006). Growth, air, flashover, wall and door
;; failure and the smoke are our own.
to grow-and-spread-fire
  ;; 1. Every burning patch grows stronger (from 0 to full strength in
  ;;    fire-growth-time seconds), and burns out when its fuel is used up.
  ask patches with [fire?] [
    set fire-time fire-time + 1
    set fire-strength min list 1 (fire-strength + 1 / fire-growth-time)
    if fire-time >= fire-burn-time [ burn-out ]
  ]

  ;; 2. A room fire can only be as big as the air through its doorways can feed.
  limit-fire-by-air

  ;; 3. Fuel near a burning patch can catch fire, but not through a wall or a closed door.
  ;;    (Patches that catch fire now only start spreading in the next second.)
  ask patches with [fire?] [
    let strength fire-strength
    ask patches in-radius fire-reach with [can-catch-fire?] [
      ;; carpet only catches fire from burning furniture or doors, not from other carpet
      if not (carpet? and [carpet?] of myself) [
        if random-float 1 < strength * catch-chance and clear-view? myself [ catch-fire ]
      ]
    ]
  ]

  ;; 4. A room with a big enough fire flashes over.
  check-flashover

  ;; 5. Walls and closed doors next to a fully burning patch heat up, and fail after a while.
  heat-walls

  ;; 6. Show the fire: orange while it grows (or lacks air), red at full strength.
  ask patches with [fire?] [
    ifelse fire-strength < 1 [ set pcolor orange ] [ set pcolor red ]
  ]
end

;; A fire needs air. When a room's fire is bigger than the air through its
;; doorways can feed (air-limit), every fire in that room burns weaker, so
;; that together they are just as big as the air allows. A fire in a closed
;; room therefore stays small, spreads slowly and makes less smoke. Once a
;; door opens, the fire grows again (step 1: at most from 0 to full strength
;; in fire-growth-time seconds).
;; After flashover the room burns at full strength anyway: what cannot burn
;; inside burns in the flames that come out of the open doorways.
;; ASSUMPTION: we ignore the air that is already in the room. In reality a
;; fire in a closed room can first grow for a minute or two on that air.
to limit-fire-by-air
  foreach remove-duplicates [room] of patches with [fire? and room != -1] [ number ->
    if not big-room? number and not member? number flashed-over-rooms [
      let power room-fire-power number
      let limit air-limit number
      if power > limit [
        ask patches with [fire? and room = number] [ set fire-strength fire-strength * limit / power ]
      ]
    ]
  ]
end

;; A patch that has fuel left and is not burning yet. A closed door does not
;; catch fire from heat radiation: it holds back the fire until it burns
;; through (see heat-walls).
to-report can-catch-fire?  ;; patch reporter
  report inflammatory? and not fire? and not burned? and not closed-door?
end

;; The chance per second that this patch catches fire from one fully burning patch nearby.
to-report catch-chance  ;; patch reporter
  if carpet? [ report carpet-catch-chance ]
  if door? [ report door-catch-chance ]   ;; an open door: the wooden door leaf standing open
  report desk-catch-chance
end

;; The fire power (kW) of this patch when it burns at full strength.
to-report full-power  ;; patch reporter
  ifelse carpet? [ report carpet-power ] [ report desk-power ]
end

to check-flashover
  foreach remove-duplicates [room] of patches with [fire? and room != -1] [ number ->
    if not member? number flashed-over-rooms [
      if room-fire-power number >= flashover-power number [ flash-over number ]
    ]
  ]
end

;; Everything in the room catches fire at once and burns at full strength,
;; and flames come out of the open doorways of the room. Closed doors hold
;; back the fire until they burn through (see heat-walls).
to flash-over [number]
  set flashed-over-rooms lput number flashed-over-rooms
  let open-doorways (item number room-doorways) with [not closed-door?]
  ask (patch-set patches with [room = number] open-doorways) with [not burned?] [ burn-at-full-strength ]
  ask open-doorways [ flames-out-of number ]
end

;; FLAMES OUT OF THE DOORWAY. A room that has flashed over gets too little air
;; to burn all its fuel inside, so the rest burns outside it: flames come out
;; of the doorway and reach flame-reach metres into the corridor (or the room
;; next door), under the ceiling. The floor there does not burn (corridors
;; have no fuel), but nobody can walk through those flames, and they can set
;; fuel nearby on fire. They last as long as the doorway burns.
to flames-out-of [number]  ;; door patch procedure; number = the room that flashed over
  ask patches in-radius flame-reach with [
    object = "floor" and indoor? and room != number and not burned? and clear-view? myself
  ] [ burn-at-full-strength ]
end

;; A closed door burns through. If the room behind it has flashed over,
;; flames now come out of this doorway too.
to door-burns-through  ;; door patch procedure
  burn-at-full-strength
  let flashed-over-side one-of neighbors4 with [member? room flashed-over-rooms]
  if flashed-over-side != nobody [ flames-out-of [room] of flashed-over-side ]
end

;; Catch fire (if not burning yet) and burn at full strength at once, without
;; the slow start. Used for flashover, and for a wall or closed door that fails.
to burn-at-full-strength  ;; patch procedure
  if not fire? [ catch-fire ]
  set fire-time max list fire-time fire-growth-time
  set fire-strength 1
end

to catch-fire  ;; patch procedure
  ;; a closed door that burns is a hole from now on: smoke, heat and air pass it
  if closed-door? [
    set door-open? true
    update-smoke-routes
  ]
  set fire? true
  set fire-strength 0
  set fire-time 0
  set pcolor orange
end

;; Every wall and closed door next to a fully burning patch gets one second
;; hotter. A wall fails after wall-fire-resistance minutes, a closed door
;; burns through after door-fire-resistance minutes. (A failed wall that burns
;; does not heat the wall next to it, so the fire does not run along a wall.)
;; A fire that lacks air never burns at full strength, so it does not heat
;; the walls and doors of its room.
to heat-walls
  let hot-patches (patch-set [neighbors4 with [object = "wall" or closed-door?]] of patches with [fire? and fire-strength = 1 and object != "failed-wall"])
  ask hot-patches [
    set wall-heat wall-heat + 1
    ifelse closed-door?
      [ if wall-heat >= door-fire-resistance * 60 [ door-burns-through ] ]
      [ if wall-heat >= wall-fire-resistance * 60 [ wall-fails ] ]
  ]
end

;; The wall no longer holds back fire and smoke. People still cannot walk
;; through it (blocked? stays true).
to wall-fails  ;; patch procedure
  set object "failed-wall"   ;; no longer a "wall": clear-view? and the smoke look through it

  ;; from now on smoke can flow through this patch
  set smoke-patches (patch-set smoke-patches self)
  update-smoke-routes

  ;; The failed wall burns, and its fire counts for the room behind it. Once
  ;; enough of the wall has failed, a small room behind it flashes over too;
  ;; a corridor or hall is too big for that and only fills with smoke.
  let room-behind one-of neighbors4 with [room != -1 and not member? room flashed-over-rooms]
  if room-behind != nobody [ set room [room] of room-behind ]
  burn-at-full-strength
end

;; The fuel is used up. The patch no longer burns, but its smoke stays around.
to burn-out  ;; patch procedure
  set fire? false
  set fire-strength 0
  set burned? true
  set pcolor gray - 2
end


;; ---------------------------------------------------------------------------
;; Schedule step (1): the smoke spreads
;; ---------------------------------------------------------------------------

to spread-smoke
  ;; The direction of the flow only changes when the fire grows (or shrinks).
  if count patches with [fire?] != fire-count-last-smoke-map [ make-fire-distance-map ]

  ;; 1. Burning patches make smoke, and are as hot as their flames.
  ask patches with [fire?] [
    set smoke min list 1 (smoke + smoke-production * fire-strength)
    set heat max list heat (flame-heat * fire-strength)
  ]

  ;; Every step, first all patches work out their new smoke, then all of them
  ;; take it at the same time, so the order of the patches does not matter.
  ;; The heat travels with the smoke, so it flows and mixes in the same way.
  repeat smoke-spread-steps [
    ;; 2. Smoke flows away from the fire: every patch passes part of its smoke
    ;;    (and heat) on to its downwind neighbours (smoke-flow-speed patches per second).
    ask smoke-patches [
      set new-smoke smoke
      set new-heat heat
    ]
    ask smoke-patches with [any? downwind] [
      let part flow-speed-here / smoke-spread-steps   ;; the part of the smoke that flows on
      let smoke-share smoke * part / count downwind
      let heat-share heat * part / count downwind
      set new-smoke new-smoke - smoke * part
      set new-heat new-heat - heat * part
      ask downwind [
        set new-smoke new-smoke + smoke-share
        set new-heat new-heat + heat-share
      ]
    ]
    ask smoke-patches [
      set smoke min list 1 new-smoke
      set heat min list flame-heat new-heat
    ]

    ;; 3. Smoke mixes from thick to thin (and heat from hot to cold): every
    ;;    patch swaps part of the difference with each neighbour.
    ask smoke-patches [
      let difference (sum [smoke] of smoke-neighbors) - (count smoke-neighbors * smoke)
      set new-smoke smoke + (smoke-spread / 4) * difference
      let heat-difference (sum [heat] of smoke-neighbors) - (count smoke-neighbors * heat)
      set new-heat heat + (smoke-spread / 4) * heat-difference
    ]
    ask smoke-patches [
      set smoke new-smoke
      set heat new-heat
    ]

    ;; 4. Smoke and heat escape to the outside through the exit doors.
    ask smoke-patches with [object = "door"] [
      set smoke 0
      set heat 0
    ]
  ]

  ;; The hot smoke cools down: it loses heat to the walls and ceiling.
  ask smoke-patches [ set heat heat * (1 - heat-loss) ]

  ;; 5. Show the smoke on the floor: the darker the grey, the thicker the smoke.
  ask smoke-patches with [object = "floor" and reachable? and not fire? and not burned?] [
    set pcolor scale-color gray smoke 1.2 0
  ]
end


;; The air temperature (C) on this patch.
to-report temperature  ;; patch reporter (also used by turtles: the temperature where they stand)
  report ambient-temperature + heat
end

;; How fast smoke flows away from the fire on this patch (m/s): full speed
;; close to the fire, slower further away because the smoke cools down.
to-report flow-speed-here  ;; patch reporter
  report smoke-flow-speed * min list 1 (smoke-flow-reach / max list 1 fire-distance)
end

;; How many steps every patch is from the nearest fire (a flood fill like
;; make-exit-distance-maps in navigation.nls, but through smoke-neighbors, so
;; also over desks). Smoke flows to the neighbours that are further away.
to make-fire-distance-map
  ask smoke-patches [ set fire-distance no-route ]
  let steps 0
  let ring smoke-patches with [fire?]
  ask ring [ set fire-distance 0 ]
  while [any? ring] [
    set steps steps + 1
    set ring patch-set [smoke-neighbors with [fire-distance = no-route]] of ring
    ask ring [ set fire-distance steps ]
  ]
  ask smoke-patches [ set downwind smoke-neighbors with [fire-distance > [fire-distance] of myself] ]
  set fire-count-last-smoke-map count patches with [fire?]
end


;; ---------------------------------------------------------------------------
;; Line of sight
;; ---------------------------------------------------------------------------

;; True when no wall or closed door stands on the straight line between me and
;; the target (a patch or a turtle). Used for heat radiation and for seeing
;; flames and exits. Through an open door you can see, and heat goes through.
;; We walk along the line in steps of half a patch and look for a wall or closed door.
to-report clear-view? [target]  ;; patch or turtle reporter
  let total-distance distance target
  if total-distance = 0 [ report true ]
  let direction towards target
  let travelled 0.5
  while [travelled < total-distance] [
    if [object = "wall" or closed-door?] of patch-at-heading-and-distance direction travelled [ report false ]
    set travelled travelled + 0.5
  ]
  report true
end

;; The burning patches I can see within the given radius (walls block the view).
to-report fire-in-sight [radius]  ;; turtle reporter
  report patches in-radius radius with [fire? and clear-view? myself]
end

;; True when my patch or one of the eight patches around it burns.
to-report fire-close-by?  ;; turtle reporter
  report fire? or any? neighbors with [fire?]
end
