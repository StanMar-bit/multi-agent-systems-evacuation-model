
;; ============================================================================
;; FIRE MODEL
;; ============================================================================

to setup-fire
  ask patches [
    set fire? false
    set smoke 0
    set fire-time 0
    set burned? false
  ]

  let start-patches patches with [
    not blocked? and
    (object = "desk" or object = "closet") and
    reachable?
  ]

  if not any? start-patches [
    set start-patches patches with [not blocked? and inflammatory? and reachable?]
  ]

  ask one-of start-patches [
    set fire? true
    set smoke 1.0
    set fire-time 0
    set pcolor red
  ]
end

to spread-fire

  ;; Spread fire to neighboring patches
  ask patches with [fire? and smoke >= 1.0] [
    ask neighbors with [not blocked? and not fire? and not burned?] [
      if-else inflammatory? [
        if random-float 1.0 < 0.85 [
          set fire? true
          set smoke 0.4
          set fire-time 0
          set pcolor red
        ]
      ] [
        if random-float 1.0 < 0.05 [
          set fire? true
          set smoke 0.2
          set fire-time 0
          set pcolor orange
        ]
      ]
    ]
  ]

  ;; Increase fire time and smoke density
ask patches with [fire?] [
  set fire-time fire-time + 1
  set smoke min (list 1.0 (smoke + 0.1))

  if pcolor = orange and smoke >= 0.8 [
    set pcolor red
  ]

  ;; Extinguish fire after 30 ticks
  if fire-time >= 30 [
    set fire? false
    set smoke 0
    set burned? true
    set pcolor gray
  ]
]
end
