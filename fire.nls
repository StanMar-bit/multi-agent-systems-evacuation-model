;; ============================================================================
;; FIRE AND SMOKE
;;
;; Scale: 1 patch = 1 m and 1 tick = 1 s, as in the rest of the model.
;;
;; How the fire works:
;;   - Only fuel burns: desks and doors (patches with inflammatory? = true,
;;     set in the environment file). Floors and walls never burn.
;;   - A burning patch starts small and grows to full strength in
;;     fire-growth-time seconds. After fire-burn-time seconds its fuel is used
;;     up and it is burned out (grey).
;;   - Every second, a burning patch can set fuel up to fire-reach metres away
;;     on fire (heat radiation), but never through a wall. The stronger the
;;     fire, the bigger the chance. Doors resist fire much longer than desks.
;;
;; How the smoke works:
;;   - Every burning patch makes smoke, more when its fire is stronger.
;;   - Smoke spreads to the neighbouring patches (never through a wall), from
;;     thick smoke to thinner smoke, so it fills the room and then flows
;;     through the doors into corridors and other rooms.
;;   - Smoke escapes to the outside through the exit doors.
;;   - ASSUMPTION: one smoke value per patch. We do not model the hot smoke
;;     layer under the ceiling separately.
;;   - The darker the grey of a floor patch, the thicker the smoke.
;;
;; The same fire in every run:
;;   - fire-location (interface) picks the desk where the fire starts.
;;   - The fire uses its own random numbers, set by fire-seed (interface).
;;     The people do not change the fire, so two runs with the same fire-seed
;;     and fire-location get exactly the same fire and smoke, whatever the
;;     evacuees do. That makes it fair to compare cognitive strategies, alarms
;;     and helpers. With fire-seed 0 every run gets a different fire.
;;
;; The agents read these patch variables:
;;   fire?   true while the patch burns (agents cannot walk on it)
;;   smoke   smoke density from 0 (clean air) to 1 (thick smoke)
;; ============================================================================

patches-own [
  fire?           ;; true while this patch burns
  fire-strength   ;; how strong the fire on this patch is, from 0 (just started) to 1 (full)
  fire-time       ;; seconds this patch has been burning
  burned?         ;; true once the fuel on this patch is used up
  smoke           ;; smoke density from 0 (clean air) to 1 (thick smoke)
  indoor?         ;; true for every patch inside the building
  smoke-neighbors ;; the neighbouring patches smoke can flow to (not walls, not outside)
  new-smoke       ;; helper for spread-smoke: the smoke on this patch after this step
]

globals [
  ;; ---- values used by the fire (ASSUMPTION: set in set-fire-parameters) ----
  fire-growth-time    ;; seconds a burning patch needs to reach full strength
  fire-burn-time      ;; seconds a patch burns before its fuel is used up
  fire-reach          ;; distance (m) over which a burning patch can set fuel on fire
  desk-catch-chance   ;; chance per second that a desk catches fire from one fully burning patch nearby
  door-catch-chance   ;; the same for a door

  ;; ---- values used by the smoke (ASSUMPTION: set in set-fire-parameters) ----
  smoke-production    ;; smoke a fully burning patch adds per second
  smoke-spread        ;; how fast smoke evens out between neighbouring patches (0 to 1)
  smoke-spread-steps  ;; how many times per second the smoke spreads

  smoke-patches       ;; all patches smoke can be on: inside the building and not a wall
  fire-dice           ;; the seed for the fire's own random numbers (see "The same fire in every run")
]


;; ---------------------------------------------------------------------------
;; Setup
;; ---------------------------------------------------------------------------

to set-fire-parameters
  set fire-growth-time 120     ;; ASSUMPTION: a desk fire needs about 2 minutes to grow to full strength
  set fire-burn-time 1800      ;; ASSUMPTION: a patch burns for about 30 minutes (office fire load ~420 MJ/m2 burning at ~250 kW/m2, Eurocode EN 1991-1-2)
  set fire-reach 2             ;; ASSUMPTION: a burning desk can set fuel up to 2 m away on fire
  set desk-catch-chance 0.02   ;; ASSUMPTION: a desk next to a fully burning desk catches fire after about a minute
  set door-catch-chance 0.002  ;; ASSUMPTION: a door resists fire ten times longer than a desk
  ;; ASSUMPTION: the three smoke values are chosen so that the room with the
  ;; fire gets noticeable smoke after about 2 minutes and thick smoke after
  ;; about 5 minutes, after which the smoke flows on into the corridors.
  set smoke-production 0.25
  set smoke-spread 0.8
  set smoke-spread-steps 4
end

;; Called once from setup: nothing burns, then one desk catches fire.
to setup-fire
  set-fire-parameters
  ask patches [
    set fire? false
    set fire-strength 0
    set fire-time 0
    set burned? false
    set smoke 0
  ]
  setup-smoke-patches

  ifelse fire-seed = 0
    [ set fire-dice random 1000000 ]   ;; a different fire every run
    [ set fire-dice fire-seed ]        ;; the same fire every run
  with-local-randomness [
    random-seed fire-dice
    ask fire-start-patch [ catch-fire ]
  ]
end

;; The desk where the fire starts, chosen with the fire-location chooser.
to-report fire-start-patch
  let desks patches with [object = "desk"]
  if fire-location = "north-west office" [ report min-one-of desks [distancexy -44 26] ]
  if fire-location = "north classroom"   [ report min-one-of desks [distancexy -33 34] ]
  if fire-location = "auditorium"        [ report min-one-of desks [distancexy 0 -25] ]
  report one-of desks                    ;; "random desk"
end

;; Find the patches smoke can be on. Outside the building is everything that
;; can be reached from the corner of the world without passing a wall, desk or
;; door (the same idea as color-outside-green in the environment file).
to setup-smoke-patches
  ask patches [ set indoor? true ]
  let frontier (patch-set patch min-pxcor max-pycor)
  ask frontier [ set indoor? false ]
  while [any? frontier] [
    let next-frontier no-patches
    ask frontier [
      ask neighbors4 with [indoor? and (object = "floor" or object = "tree")] [
        set indoor? false
        set next-frontier (patch-set next-frontier self)
      ]
    ]
    set frontier next-frontier
  ]

  set smoke-patches patches with [indoor? and object != "wall"]
  ask smoke-patches [ set smoke-neighbors neighbors4 with [indoor? and object != "wall"] ]
end


;; ---------------------------------------------------------------------------
;; Schedule step (1): the fire grows and spreads
;; ---------------------------------------------------------------------------

to spread-fire
  ;; The fire's own random numbers: the same fire-dice and tick give the same fire.
  with-local-randomness [
    random-seed fire-dice + ticks
    grow-and-spread-fire
  ]
end

to grow-and-spread-fire
  ;; 1. Every burning patch grows stronger, and burns out when its fuel is used up.
  ask patches with [fire?] [
    set fire-time fire-time + 1
    set fire-strength min list 1 (fire-time / fire-growth-time)
    if fire-time >= fire-burn-time [ burn-out ]
  ]

  ;; 2. Fuel near a burning patch can catch fire, but not through a wall.
  ;;    (Patches that catch fire now only start spreading in the next second.)
  ask patches with [fire?] [
    let strength fire-strength
    ask patches in-radius fire-reach with [can-catch-fire?] [
      if random-float 1 < strength * catch-chance and clear-view? myself [ catch-fire ]
    ]
  ]

  ;; 3. Show the fire: orange while it grows, red at full strength.
  ask patches with [fire?] [
    ifelse fire-strength < 1 [ set pcolor orange ] [ set pcolor red ]
  ]
end

;; A patch that has fuel left and is not burning yet.
to-report can-catch-fire?  ;; patch reporter
  report inflammatory? and not fire? and not burned?
end

;; The chance per second that this patch catches fire from one fully burning patch nearby.
to-report catch-chance  ;; patch reporter
  ifelse member? object ["door" "intermediate-door"]
    [ report door-catch-chance ]
    [ report desk-catch-chance ]
end

to catch-fire  ;; patch procedure
  set fire? true
  set fire-strength 0
  set fire-time 0
  set pcolor orange
end

;; The fuel is used up. The patch no longer burns, but its smoke stays around.
to burn-out  ;; patch procedure
  set fire? false
  set fire-strength 0
  set burned? true
  set pcolor gray - 2
end


;; ---------------------------------------------------------------------------
;; Schedule step (1): the smoke spreads
;; ---------------------------------------------------------------------------

to spread-smoke
  ;; 1. Burning patches make smoke.
  ask patches with [fire?] [
    set smoke min list 1 (smoke + smoke-production * fire-strength)
  ]

  ;; 2. Smoke flows from thick to thin: every patch swaps part of the difference
  ;;    with each neighbour. First all patches work out their new smoke, then
  ;;    all of them take it at the same time, so the order does not matter.
  repeat smoke-spread-steps [
    ask smoke-patches [
      let difference (sum [smoke] of smoke-neighbors) - (count smoke-neighbors * smoke)
      set new-smoke smoke + (smoke-spread / 4) * difference
    ]
    ask smoke-patches [ set smoke new-smoke ]

    ;; 3. Smoke escapes to the outside through the exit doors.
    ask smoke-patches with [object = "door"] [ set smoke 0 ]
  ]

  ;; 4. Show the smoke on the floor: the darker the grey, the thicker the smoke.
  ask smoke-patches with [object = "floor" and reachable?] [
    set pcolor scale-color gray smoke 1.2 0
  ]
end


;; ---------------------------------------------------------------------------
;; Line of sight
;; ---------------------------------------------------------------------------

;; True when no wall stands on the straight line between me and the target
;; (a patch or a turtle). Used for heat radiation and for seeing flames.
;; We walk along the line in steps of half a patch and look for a wall.
to-report clear-view? [target]  ;; patch or turtle reporter
  let total-distance distance target
  if total-distance = 0 [ report true ]
  let direction towards target
  let travelled 0.5
  while [travelled < total-distance] [
    if [object = "wall"] of patch-at-heading-and-distance direction travelled [ report false ]
    set travelled travelled + 0.5
  ]
  report true
end

;; The burning patches I can see within the given radius (walls block the view).
to-report fire-in-sight [radius]  ;; turtle reporter
  report patches in-radius radius with [fire? and clear-view? myself]
end

;; True when my patch or one of the eight patches around it burns.
to-report fire-close-by?  ;; turtle reporter
  report fire? or any? neighbors with [fire?]
end
