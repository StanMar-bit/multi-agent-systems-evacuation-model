;; ============================================================================
;; TURTLE VARIABLES SHARED BY EVACUEES AND HELPERS
;;
;; NetLogo does not allow a breed to declare a variable that turtles-own
;; already has, so the variables that both breeds use are declared here.
;; (The first prototype of the agents used to live in this file; it was
;; replaced by evacuees.nls and helpers.nls and removed.)
;; ============================================================================

turtles-own [
  speed            ;; walking speed in m/s (= patches per tick)
  step-length      ;; length (m) of the last step: 1 straight or 1.41 diagonal (navigation.nls)
  cognitive-state  ;; "unaware", "waiting", "rational", "familiar", "follower" or "panic" ("helper" for helpers)
  agent-arousal    ;; arousal level A, from 0 (calm) to 1 (maximum), as in the proposal
]
