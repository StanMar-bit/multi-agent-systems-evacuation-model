<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[__includes [
  "agents.nls"           ;; turtle variables shared by evacuees and helpers
  "environment_cube.nls" ;; floor plan: walls, doors and desks
  "alarm-and-fire.nls"   ;; the alarm
  "fire.nls"             ;; fire and smoke
  "navigation.nls"       ;; exits, distance maps and taking steps
  "evacuees.nls"         ;; evacuee agents
  "helpers.nls"          ;; helper agents
]

to setup
  clear-all
  setup-environment
  compute-reachable-area
  setup-fire             ;; one desk catches fire
  setup-alarm            ;; place the smoke detectors; the alarm is off
  setup-navigation       ;; find the exits and make the distance maps
  setup-evacuees
  setup-helpers

  reset-ticks
end



to go
  ;; Stop the simulation automatically if everyone has escaped or reached safety,
  ;; or after max-duration ticks (proposal: 900 ticks = 900 s)
  if not any? evacuees or ticks >= max-duration [ stop ]

  ;; The schedule from the proposal. One tick is one second.
  spread-fire                  ;; (1) fire and smoke spread
  spread-smoke
  update-alarm                 ;; (2) smoke detectors and alarm
  update-exit-distance-maps    ;;     routes change when the fire blocks patches
  evacuees-perceive            ;; (3) evacuees perceive and update arousal and state
  helpers-instruct             ;; (4) helpers instruct
  move-evacuees                ;; (5) all agents move, at most one agent per patch
  move-helpers
  update-evacuee-health        ;; (6) health and counts are updated

  tick                 ;; Advance time by 1 step
end]]></code>
