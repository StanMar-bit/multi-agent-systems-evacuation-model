;; =====================================================================
;; FLOOR PLAN - walls, doors and desks (SYMMETRICAL VERSION)
;; World: x from -54 to 54, y from -44 to 44. The building itself is x -50..50
;; and y -42..42; the free strip of 4 patches around it is for the trees.
;; The middle column is x = 0, so left and right are exact mirrors.
;; =====================================================================

patches-own [
  object        ;; "floor" or "wall" or "door" or "intermediate-door" or "desk" or "closet" or "tree"
  blocked?      ;; true if agents cannot walk here (wall or desk), false for floor and door openings
  reachable?    ;; true if this patch is connected to the building interior (set by compute-reachable-area)
  inflammatory? ;; true if this patch can burn (desk, doors, ...)
]

;; ---------------------------------------------------------------------
;; MAIN SETUP
;; ---------------------------------------------------------------------

to setup-environment
  clear-all
  resize-world -54 54 -44 44
  set-patch-size 6

  ;;everything starts as open white floor
  ask patches [
    set pcolor white
    set object "floor"
    set blocked? false
    set reachable? false
    set inflammatory? false
  ]

  ;; build the walls, area by area
  build-walls

  ;; cut the doors (openings) into the walls, as written in the code
  build-doors
  
  ;;grass: the outside of the building + the two closed boxes of cube
  color-outside-green
  color-courtyards-green

  ;;put the flammable objects (desks) in the rooms
  setup-inflammatory-objects
end

;; buiding walls based on area
to build-walls
  build-outer-walls
  build-top-rooms
  build-upper-wing
  build-side-rooms
  build-tall-boxes
  build-central-block
  build-lower-wing
  build-auditorium
end

;; ---------------------------------------------------------------------
;; HELPERS - almst every wall/door is drawn on the left AND mirrored to the right (cube is almost symmetric)
;; ---------------------------------------------------------------------

;; Symmetrical one:

;; horizontal wall: row y, from x1 to x2 (+ mirror image)
to h-wall [y x1 x2]
  ask patches with [pycor = y and
      ((pxcor >= x1 and pxcor <= x2) or (pxcor >= (- x2) and pxcor <= (- x1)))] [ mark-as-wall ]
end

;; vertical wall: column x, from y1 to y2 (+ mirror image)
to v-wall [x y1 y2]
  ask patches with [(pxcor = x or pxcor = (- x)) and pycor >= y1 and pycor <= y2] [ mark-as-wall ]
end

;; door in a horizontal wall (+ mirror image)
to door-h [y x1 x2 door-color]
  ask patches with [pycor = y and
      ((pxcor >= x1 and pxcor <= x2) or (pxcor >= (- x2) and pxcor <= (- x1)))] [ mark-as-door door-color ]
end

;; door in a vertical wall (+ mirror image)
to door-v [x y1 y2 door-color]
  ask patches with [(pxcor = x or pxcor = (- x)) and pycor >= y1 and pycor <= y2] [ mark-as-door door-color ]
end

;; One-sided: NOT mirrored -----
to h-wall-one [y x1 x2]
  ask patches with [pycor = y and pxcor >= x1 and pxcor <= x2] [ mark-as-wall ]
end

to v-wall-one [x y1 y2]
  ask patches with [pxcor = x and pycor >= y1 and pycor <= y2] [ mark-as-wall ]
end

to door-h-one [y x1 x2 door-color]
  ask patches with [pycor = y and pxcor >= x1 and pxcor <= x2] [ mark-as-door door-color ]
end

to door-v-one [x y1 y2 door-color]
  ask patches with [pxcor = x and pycor >= y1 and pycor <= y2] [ mark-as-door door-color ]
end

to mark-as-wall
  set object "wall"
  set blocked? true
  set pcolor black
end

;; a door is walkable (blocked? = false) and shows in its color - we made different colors for the kind of door we have
;; green doors are exits ("door"), the other colors are "intermediate-door"- still in the building is used by agent
to mark-as-door [door-color]
  ifelse door-color = green
    [ set object "door" ]
    [ set object "intermediate-door" ]
  set blocked? false ;; agents can walk through doors
  set inflammatory? true
  set pcolor door-color
end

;; Colors everything outside the building green
;; Doors are not "floor", so it stops at them and never goes inside.
to color-outside-green
  let frontier (patch-set patch min-pxcor max-pycor)
  ask frontier [ set pcolor green + 3 ]
  while [any? frontier] [
    let next-frontier no-patches
    ask frontier [
      ask neighbors4 with [object = "floor" and pcolor = white] [
        set pcolor green + 3
        set next-frontier (patch-set next-frontier self)
      ]
    ]
    set frontier next-frontier
  ]
end

;; Colors the inside of the two tall boxes (the ones with no doors) green.
to color-courtyards-green
  ask patches with [object = "floor" and abs pxcor >= 22 and abs pxcor <= 32
                    and pycor >= -7 and pycor <= 15] [
    set pcolor green + 3
  ]
end

;; Finds every patch an agent could walk to, starting from the middle of the building. It marks them reachable? = true. 
;; Walls block the spreading - change
to compute-reachable-area
  ;;start - nothing is reachable
  ask patches [ set reachable? false ]

  ;;start with patch in the center/middle, BUT only if floor (not a wall, desk, etc.)
  let seed one-of patches with [object = "floor" and pxcor = 0 and pycor = 0]
  ;; if (0,0) not floor - take any floor patch within 3 steps of it instead
  if seed = nobody [
    set seed one-of patches with [object = "floor" and distance patch 0 0 < 3]
  ]

  ask seed [ set reachable? true ]
  let frontier (patch-set seed)

  ;;keep spreading until there is nothing new to mark
  while [any? frontier] [
    let new-frontier patch-set nobody
    ask frontier [
      ask neighbors4 with [not blocked? and not reachable?] [
        set reachable? true
        set new-frontier (patch-set new-frontier self)
      ]
    ]
    set frontier new-frontier
  ]
end


;; =====================================================================
;; FLAMMABLE OBJECTS
;; =====================================================================
;; Two types:  desk (brown)  tree (green)

to setup-inflammatory-objects
  place-objects-upper-rooms
  place-objects-inner-part
  place-objects-side-rooms
  place-objects-lower-rooms
  place-objects-outside

  ;; DOORS: keep existing colors and functionality (doors can burn too)
  ask patches with [member? object (list "door" "intermediate-door")] [
    set inflammatory? true
  ]
end

;; helpers
;; a row of desks on row y, from x1 to x2 (+ mirror image)
to desk-row [y x1 x2]
  ask patches with [pycor = y and object = "floor" and
      ((pxcor >= x1 and pxcor <= x2) or (pxcor >= (- x2) and pxcor <= (- x1)))] [ mark-as-desk ]
end

;; a row of desks on row y, from x1 to x2 (NOT mirrored)
to desk-row-one [y x1 x2]
  ask patches with [pycor = y and pxcor >= x1 and pxcor <= x2 and object = "floor"] [ mark-as-desk ]
end

to desk-two [x y]
  ask patches with [(pxcor = x or pxcor = (- x)) and pycor = y and object = "floor"] [ mark-as-desk ]
end

to desk [x y]
  ask patches with [pxcor = x and pycor = y and object = "floor"] [ mark-as-desk ]
end

to mark-as-desk
  set object "desk"
  set blocked? true      ;; desks are furniture: people walk around them, not over them
  set inflammatory? true
  set pcolor brown
end

to tree [x y]
  ask patches with [(pxcor = x or pxcor = (- x)) and pycor = y and object = "floor"] [ mark-as-tree ]
end

to tree-one [x y]
  ask patches with [pxcor = x and pycor = y and object = "floor"] [ mark-as-tree ]
end

to mark-as-tree
  set object "tree"
  set inflammatory? true
  set pcolor green + 2
end

