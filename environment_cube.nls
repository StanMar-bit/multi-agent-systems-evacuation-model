  h-wall    10  -50  -45
  h-wall    5  -50  -45
  h-wall   0  -50  -45
  h-wall   -4  -50  -45
  h-wall   12  -42  -35
  h-wall    9  -42  -35
  h-wall   5  -42  -35
  h-wall   2  -42  -35 
