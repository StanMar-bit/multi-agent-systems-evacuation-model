;; =====================================================================
;; DOORS - ADD YOUR DOORS HERE (left side only, right is mirrored, if -one then not mirrored)
;; =====================================================================
to build-doors
  ;; colors:  green = exit, turquoise = inner door, blue = office/top-room door
  ;; Inner doors (Turquoise)
  door-v  -36   19   21  turquoise ;; upper wing room -> hall
  door-v  -36  -16  -14  turquoise ;; lower wing room 1 -> lobby
  door-v   36  -23  -23  turquoise ;; lower wing room (this one is on the right side)
  door-v   36  -29  -29  turquoise ;; lower wing room (this one is on the right side)
  door-v  -23  -19  -17  turquoise ;; auditorium entrance (side)

  ;; Office/top-room doors (Blue)
  door-h-one   28  -27  -25  blue ;; top room 1 -> hall (left, not mirrored)
  door-h-one   28   33   35  blue ;; top room 1 (right side)
  door-h-one   28  -15  -13  blue ;; top room 2 -> hall (left, not mirrored)
  door-h-one   28   21   23  blue ;; top room 2 (right side)
  door-h   18   -8   -6  blue ;; central block room -> hall

  ;; Main Building Exit Doors (Green)
  door-v   36  -38  -34  green ;; main exit
  door-h  -42  -34  -32  green ;; EXIT: bottom corner entrance
end

;; =====================================================================
;; AREA OUT: OUTER WALLS
;; =====================================================================
to build-outer-walls
  h-wall   42  -36   36 ;; top outer wall (spans the whole width)
  h-wall  -42  -36   36 ;; (spans the whole width)
  v-wall  -50  -30   30 ;; left outer wall (right side is mirrored at x=50)
  h-wall   30  -50  -36 ;; top of the upper wing room
  h-wall  -30  -50  -36 ;; bottom of the lower wing
  v-wall  -36   18   42 ;; left wall of the top section + upper wing room
  v-wall  -36  -42  -11 ;; left wall of the lower wing + entrance hall
end

;; =====================================================================
;; AREA TOP: TOP ROOMS (five rooms across the top)
;; =====================================================================
to build-top-rooms
  v-wall  -24   28   42 ;; divider between room 1 and room 2
  v-wall  -12   28   42 ;; divider between room 2 and the big centre room
  h-wall   28  -36  -12 ;; bottom wall of the top rooms (the centre room is open)
end

;; =====================================================================
;; AREA WING: UPPER WING ROOMS (top left and top right)
;; =====================================================================
to build-upper-wing
